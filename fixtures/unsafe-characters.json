{
  "description": "Text rules of ADR-0013, shared by the vault-core rule, the CLI escaper (vault-cli render::escape) and the web client's escaper (web/src/text.ts displayText). Code points are hex, without U+. 'unsafe' ranges are refused in every non-hidden field and escaped by both front ends; those marked 'control' are refused in hidden fields too. 'multiline_safe' are unsafe ranges' members that notes keep. 'safe' are look-alikes that are accepted and shown as they are.",
  "unsafe": [
    { "from": "0000", "to": "001F", "control": true, "name": "C0 controls (incl. tab, newline, carriage return, escape)" },
    { "from": "007F", "to": "009F", "control": true, "name": "delete and C1 controls (incl. next line)" },
    { "from": "00AD", "to": "00AD", "control": false, "name": "soft hyphen" },
    { "from": "0600", "to": "0605", "control": false, "name": "Arabic number signs" },
    { "from": "061C", "to": "061C", "control": false, "name": "Arabic letter mark" },
    { "from": "06DD", "to": "06DD", "control": false, "name": "Arabic end of ayah" },
    { "from": "070F", "to": "070F", "control": false, "name": "Syriac abbreviation mark" },
    { "from": "0890", "to": "0891", "control": false, "name": "Arabic pound and piastre mark above" },
    { "from": "08E2", "to": "08E2", "control": false, "name": "Arabic disputed end of ayah" },
    { "from": "180E", "to": "180E", "control": false, "name": "Mongolian vowel separator" },
    { "from": "200B", "to": "200F", "control": false, "name": "zero-width space, non-joiner, joiner, LRM, RLM" },
    { "from": "2028", "to": "2029", "control": false, "name": "line and paragraph separators" },
    { "from": "202A", "to": "202E", "control": false, "name": "bidirectional embeddings and overrides" },
    { "from": "2060", "to": "2064", "control": false, "name": "word joiner and invisible operators" },
    { "from": "2066", "to": "206F", "control": false, "name": "bidirectional isolates and deprecated format characters" },
    { "from": "FEFF", "to": "FEFF", "control": false, "name": "byte order mark / zero-width no-break space" },
    { "from": "FFF9", "to": "FFFB", "control": false, "name": "interlinear annotation characters" },
    { "from": "110BD", "to": "110BD", "control": false, "name": "Kaithi number sign" },
    { "from": "110CD", "to": "110CD", "control": false, "name": "Kaithi number sign above" },
    { "from": "13430", "to": "1343F", "control": false, "name": "Egyptian hieroglyph format controls" },
    { "from": "1BCA0", "to": "1BCA3", "control": false, "name": "shorthand format controls" },
    { "from": "1D173", "to": "1D17A", "control": false, "name": "musical symbol format controls" },
    { "from": "E0001", "to": "E0001", "control": false, "name": "language tag" },
    { "from": "E0020", "to": "E007F", "control": false, "name": "tag characters" }
  ],
  "multiline_safe": ["0009", "000A"],
  "safe": [
    { "char": "0020", "name": "space (inside text)" },
    { "char": "00A0", "name": "no-break space (inside text)" },
    { "char": "200A", "name": "hair space, looks like a zero-width space" },
    { "char": "3000", "name": "ideographic space (inside text)" },
    { "char": "2010", "name": "hyphen, looks like a soft hyphen" },
    { "char": "2011", "name": "non-breaking hyphen" },
    { "char": "00E9", "name": "é, precomposed" },
    { "char": "0301", "name": "combining acute accent" },
    { "char": "0430", "name": "Cyrillic а, looks like Latin a" },
    { "char": "05D0", "name": "Hebrew alef (right-to-left letter)" },
    { "char": "0627", "name": "Arabic alef (right-to-left letter)" },
    { "char": "2215", "name": "division slash, looks like /" },
    { "char": "1F511", "name": "key emoji" }
  ]
}
